# ============================================================
# keiba-predictor 環境変数設定ファイル
# このファイルを .env にコピーして各値を入力してください
# cp .env.example .env  (Mac/Linux)
# copy .env.example .env  (Windows)
# ============================================================

# ---- X (Twitter) API ----------------------------------------
# https://developer.twitter.com/ で取得
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# ---- note.com -----------------------------------------------
# note.com のログインメールアドレスとパスワード
NOTE_EMAIL=your_note_email@example.com
NOTE_PASSWORD=your_note_password_here

# ---- 任意設定 -----------------------------------------------
# X/note への自動投稿を無効にする場合は false に設定
# AUTO_POST_X=false
# AUTO_POST_NOTE=false
