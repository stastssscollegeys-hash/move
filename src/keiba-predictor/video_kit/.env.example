# .env にコピーして書き換える（.env は人に渡さない）
# Gemini TTS（Google AI Studio のAPIキー）。複数あると上限のときに順に切り替える
GEMINI_API_KEY=
GEMINI_API_KEY2=
# 使う音声モデル（空なら gemini-3.8-flash-tts。2026-11-19 から既定。対話モードの声もこのモデルで作る）
TTS_MODEL=

# 置き場所（Python の道具は環境変数から読む。シェルで先に設定する）
KVC_WORK_ROOT=work
KVC_CHAR_SHEET=assets/character_sheet.png
KVC_BGM_DIR=assets/bgm
KVC_SE_DIR=assets/se
# 画像生成・YouTube下書きで使う Chrome のデバッグポート
CDP_PORT=9222
